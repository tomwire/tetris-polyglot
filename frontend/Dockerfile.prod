# Frontend — Production (Vite build → Nginx static files)
FROM node:22-slim AS builder
WORKDIR /app

# package-lock.json is intentionally gitignored, so use `npm install` (not `npm ci`).
COPY package*.json ./
RUN npm install

COPY tsconfig.json .
COPY vite.config.ts .
COPY index.html .
COPY src/ ./src/

RUN npx vite build --base=/

# Serve with nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
